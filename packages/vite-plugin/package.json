{
    "name": "@greenhat-services/magpie-vite-plugin",
    "version": "0.1.3",
    "description": "Uploads source maps to Magpie, records the release and its commits, and injects the release into your Vite build.",
    "license": "MIT",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup",
        "prepack": "npm run build"
    },
    "peerDependencies": {
        "vite": ">=5.0.0"
    },
    "devDependencies": {
        "vite": "^7.0.0"
    },
    "engines": {
        "node": ">=20"
    },
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Greenhat-Services/magpie-js.git",
        "directory": "packages/vite-plugin"
    },
    "keywords": [
        "magpie",
        "vite",
        "vite-plugin",
        "sourcemaps",
        "release"
    ]
}
