{
    "name": "@greenhat-services/magpie-core",
    "version": "0.1.3",
    "description": "Platform-neutral core of the Magpie JavaScript SDKs: events, scope, tracing and the client.",
    "license": "MIT",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup",
        "prepack": "npm run build"
    },
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Greenhat-Services/magpie-js.git",
        "directory": "packages/core"
    },
    "keywords": [
        "magpie",
        "error-tracking",
        "monitoring"
    ]
}
