{
    "name": "@greenhat-services/magpie-browser",
    "version": "0.1.0",
    "description": "Magpie error tracking and performance monitoring for the browser.",
    "license": "MIT",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "files": ["dist"],
    "scripts": {
        "build": "tsup"
    },
    "dependencies": {
        "@greenhat-services/magpie-core": "^0.1.0"
    },
    "publishConfig": { "access": "public" },
    "repository": { "type": "git", "url": "git+https://github.com/Greenhat-Services/magpie-js.git", "directory": "packages/browser" },
    "keywords": ["magpie", "error-tracking", "monitoring", "browser"]
}
