{
    "name": "@greenhat-services/magpie-vue",
    "version": "0.1.1",
    "description": "Magpie error tracking and performance monitoring for Vue 3 and Vue Router.",
    "license": "MIT",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup",
        "prepack": "npm run build"
    },
    "dependencies": {
        "@greenhat-services/magpie-browser": "^0.1.0"
    },
    "peerDependencies": {
        "vue": "^3.3.0"
    },
    "devDependencies": {
        "vue": "^3.5.0",
        "vue-router": "^4.5.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Greenhat-Services/magpie-js.git",
        "directory": "packages/vue"
    },
    "keywords": [
        "magpie",
        "error-tracking",
        "monitoring",
        "vue",
        "vue-router"
    ]
}
